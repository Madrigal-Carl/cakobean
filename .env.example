# CaKoBean — copy this file to `.env` and fill in your Supabase values.
# Get them from your Supabase dashboard: Settings → API.
#
#   - SUPABASE_URL is the "Project URL".
#   - SUPABASE_ANON_KEY is the `anon` (publishable) key. It is safe to ship
#     in the app — security is enforced by Row Level Security, not by the key.
#     NEVER use the `service_role` (secret) key here.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
